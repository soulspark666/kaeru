# Stage1 storage hooks. stageone is unusable on this device (see the
# prefetch-abort note in the knowledge base), and nothing in the kaeru
# payload reads these, but they are `hex` with no default, so leaving them
# unset makes silentoldconfig prompt and abort. Placeholders keep
# `make cupida_defconfig && make kaeru` reproducible from a clean tree.
CONFIG_INIT_STORAGE_CALLER=0x0
CONFIG_INIT_STORAGE_ADDRESS=0x0
CONFIG_PARTITION_READ_ADDRESS=0x0
CONFIG_PARTITION_GET_SIZE_BY_NAME_ADDRESS=0x0
